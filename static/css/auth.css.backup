/* Scrollbar Dorada */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: #000;
}

::-webkit-scrollbar-thumb {
  background: var(--gold-dark);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--gold-mid);
}

/* ===== Responsive Design ===== */

/* Tablet (< 768px) */
@media (max-width: 768px) {
  body {
    padding: 20px 0;
  }

  .container {
    max-width: 100%;
    padding: 15px;
  }

  .form-box {
    padding: 30px 25px;
    border-radius: 20px;
  }

  .logo-unyx {
    width: 80px;
  }

  h2 {
    font-size: 1.6rem;
  }

  .subtitle {
    font-size: 0.85rem;
  }

  .input-group input {
    padding: 14px 18px 14px 45px;
    font-size: 0.95rem;
  }

  .input-group .icon {
    font-size: 1.1rem;
    left: 16px;
  }

  .btn-submit {
    padding: 14px;
    font-size: 0.95rem;
  }

  .modal-content {
    width: 95%;
    padding: 30px 25px;
    margin: 10% auto;
  }
}

/* Mobile (< 480px) */
@media (max-width: 480px) {
  body {
    padding: 15px 0;
  }

  .container {
    padding: 10px;
  }

  .form-box {
    padding: 25px 20px;
    border-radius: 16px;
  }

  .logo-container {
    margin-bottom: 25px;
  }

  .logo-unyx {
    width: 70px;
  }

  h2 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 0.8rem;
    margin-bottom: 25px;
  }

  .input-group {
    margin-bottom: 16px;
  }

  .input-group input {
    padding: 13px 16px 13px 42px;
    font-size: 0.9rem;
    border-radius: 12px;
  }

  .input-group .icon {
    font-size: 1rem;
    left: 14px;
  }

  .btn-submit {
    padding: 13px;
    font-size: 0.9rem;
    margin-top: 20px;
    min-height: 48px;
    /* Táctil */
  }

  .divider {
    margin: 20px 0;
    font-size: 0.75rem;
  }

  .social-login {
    gap: 10px;
  }

  .social-btn {
    padding: 12px;
    font-size: 0.85rem;
    min-height: 48px;
    /* Táctil */
  }

  .social-btn .icon {
    font-size: 1.1rem;
  }

  .footer-text {
    font-size: 0.8rem;
    margin-top: 20px;
  }

  .footer-text a {
    font-size: 0.85rem;
  }

  .modal-content {
    width: 95%;
    padding: 25px 20px;
    margin: 5% auto;
    border-radius: 16px;
  }

  .close {
    top: 15px;
    right: 15px;
    font-size: 26px;
  }

  .modal-body {
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .modal-body h2 {
    font-size: 1.3rem;
  }
}

/* Small Mobile (< 360px) */
@media (max-width: 360px) {
  .form-box {
    padding: 20px 15px;
  }

  h2 {
    font-size: 1.3rem;
  }

  .input-group input {
    padding: 12px 14px 12px 40px;
    font-size: 0.85rem;
  }

  .btn-submit {
    padding: 12px;
    font-size: 0.85rem;
  }

  .social-btn {
    padding: 10px;
    font-size: 0.8rem;
  }
}