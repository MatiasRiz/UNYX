/* ===== UNYX Auth HYPER-PREMIUM Styles ===== */
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap');

:root {
  --gold-light: #f9e5a2;
  --gold-mid: #d4af37;
  --gold-dark: #8a6e1e;
  --bg-deep: #000000;
  --glass-bg: rgba(20, 20, 20, 0.85);
  --neon-glow: 0 0 15px rgba(212, 175, 55, 0.4);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Outfit', sans-serif;
  background-color: var(--bg-deep);
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  overflow-y: auto;
  position: relative;
  padding: 40px 0;
}

/* ===== Fondo Animado Complejo ===== */
body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: repeating-linear-gradient(45deg,
      transparent 0px,
      transparent 10px,
      rgba(212, 175, 55, 0.15) 10px,
      rgba(212, 175, 55, 0.15) 12px);
  z-index: -2;
}

body::after {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at center, transparent 0%, #000 90%);
  z-index: -1;
  pointer-events: none;
}

/* ===== Contenedor Principal ===== */
.container {
  width: 100%;
  max-width: 480px;
  padding: 20px;
  position: relative;
  z-index: 10;
  margin: auto;
}

/* ===== Tarjeta Glassmorphism Avanzada ===== */
.form-box {
  background: var(--glass-bg);
  backdrop-filter: blur(25px) saturate(180%);
  -webkit-backdrop-filter: blur(25px) saturate(180%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);
  border-radius: 24px;
  padding: 40px 40px;
  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.8),
    inset 0 0 0 1px rgba(255, 255, 255, 0.05);
}

/* ===== Logo con Efecto Metálico ===== */
.logo-container {
  text-align: center;
  margin-bottom: 35px;
  position: relative;
}

.logo-unyx {
  width: 100px;
  filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.6));
  transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.logo-unyx:hover {
  transform: scale(1.15) rotate(3deg);
  filter: drop-shadow(0 0 25px rgba(212, 175, 55, 0.9));
}

/* ===== Tipografía de Lujo ===== */
h1 {
  text-align: center;
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #fff;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  position: relative;
}

p {
  text-align: center;
  font-size: 0.95rem;
  color: #ccc;
  margin-bottom: 40px;
  font-weight: 300;
  letter-spacing: 0.5px;
}

/* Clase .gold para textos y enlaces */
.gold {
  color: var(--gold-mid) !important;
  text-decoration: none;
  font-weight: 600;
  position: relative;
  transition: all 0.3s ease;
  -webkit-text-fill-color: var(--gold-mid) !important;
}

a.gold:hover {
  color: var(--gold-light) !important;
  text-shadow: 0 0 10px rgba(212, 175, 55, 0.6);
}

.gold::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 1px;
  bottom: -2px;
  left: 0;
  background: var(--gold-mid);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.3s ease;
}

.gold:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

/* ===== Inputs Futuristas ===== */
.input-group {
  margin-bottom: 25px;
  position: relative;
}

.input-group label {
  display: block;
  margin-bottom: 10px;
  font-size: 0.8rem;
  color: var(--gold-mid);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 600;
  margin-left: 5px;
}

.input-group input {
  width: 100%;
  padding: 16px 20px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid #333;
  border-radius: 12px;
  color: #fff;
  font-size: 1rem;
  font-family: 'Outfit', sans-serif;
  transition: all 0.3s ease;
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.5);
}

.input-group input:focus {
  outline: none;
  border-color: var(--gold-mid);
  background: rgba(0, 0, 0, 0.6);
  box-shadow:
    inset 0 2px 5px rgba(0, 0, 0, 0.5),
    0 0 15px rgba(212, 175, 55, 0.2);
  transform: scale(1.02);
}

/* ===== Botón "Lingote de Oro" ===== */
.btn {
  width: 100%;
  padding: 18px;
  margin-top: 10px;
  background: linear-gradient(to bottom, #f9e5a2 0%, #d4af37 50%, #8a6e1e 100%);
  color: #1a1a1a;
  font-size: 1.1rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 2px;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  box-shadow:
    0 5px 15px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
  transition: left 0.5s;
}

.btn:hover {
  transform: translateY(-3px);
  box-shadow:
    0 15px 30px rgba(212, 175, 55, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

.btn:hover::before {
  left: 100%;
}

.btn:active {
  transform: translateY(1px);
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
}

/* ===== Checkbox Estilizado ===== */
.checkbox {
  display: flex;
  align-items: center;
  color: #888;
  font-size: 0.9rem;
  margin-bottom: 30px;
  cursor: pointer;
}

.checkbox input {
  appearance: none;
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  border: 1px solid #555;
  border-radius: 5px;
  margin-right: 10px;
  background: rgba(0, 0, 0, 0.5);
  position: relative;
  cursor: pointer;
  transition: all 0.2s;
}

.checkbox input:checked {
  background: var(--gold-mid);
  border-color: var(--gold-mid);
}

.checkbox input:checked::after {
  content: '✔';
  position: absolute;
  color: #000;
  font-size: 14px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: bold;
}

/* ===== Modal Premium ===== */
.modal {
  display: none;
  position: fixed;
  z-index: 2000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(10px);
}

.modal-content {
  background: #0a0a0a;
  border: 1px solid var(--gold-mid);
  margin: 5% auto;
  padding: 40px;
  width: 90%;
  max-width: 600px;
  border-radius: 20px;
  box-shadow: 0 0 50px rgba(212, 175, 55, 0.15);
  position: relative;
  animation: zoomIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes zoomIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }

  to {
    transform: scale(1);
    opacity: 1;
  }
}

.close {
  position: absolute;
  top: 20px;
  right: 25px;
  color: var(--gold-mid);
  font-size: 30px;
  cursor: pointer;
  transition: transform 0.3s;
}

.close:hover {
  transform: rotate(90deg) scale(1.2);
  color: #fff;
}

.modal-body {
  color: #ccc;
  line-height: 1.8;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-body h2 {
  color: var(--gold-mid);
  border-bottom: 1px solid #333;
  padding-bottom: 10px;
  margin-bottom: 20px;
}

/* Scrollbar Dorada */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: #000;
}

color: var(--gold-mid);
text-transform: uppercase;
letter-spacing: 1.5px;
font-weight: 600;
margin-left: 5px;
}

.input-group input {
  width: 100%;
  padding: 16px 20px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid #333;
  border-radius: 12px;
  color: #fff;
  font-size: 1rem;
  font-family: 'Outfit', sans-serif;
